#!name=360摄像机去广告
#!desc=净化360摄像机首页推广、商城活动、闪购和安防报告摘要，保留设备、事件与录像接口
#!author=Hollowwill521
#!category=去广告
#!tag=360摄像机,广告净化

[Rule]
DOMAIN,shop177583286.youzan.com,REJECT,extended-matching,pre-matching
DOMAIN,shop177583286.m.youzan.com,REJECT,extended-matching,pre-matching
DOMAIN,ad.jia.360.cn,REJECT,extended-matching,pre-matching
DOMAIN,ad.iot.360.cn,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https://jia\.360\.cn/mall/index_xufei\.html(?:\?.*)?$ _ reject

[Body Rewrite]
http-response-jq ^https:\/\/jia\.360\.cn\/conf\/v1\.json 'delpaths([["tab_conf"]])'
http-response-jq ^https:\/\/jia\.360\.cn\/conf\/v1\.json 'delpaths([["ad_conf"]])'
http-response-jq ^https:\/\/jia\.360\.cn\/conf\/v1\.json 'delpaths([["activity"]])'

[Script]
360 Camera Presentation Cleanup = type=http-response,pattern=^https://(?:jia\.360\.cn/(?:conf/v1\.json|data/yunlu/(?:promotion|promotion_app|specialpromotion)\.json|mall/xufei/(?:activitys|flashMob)\.json)|q5\.jia\.360\.cn/event/getStatistics)(?:\?|$),script-path=https://raw.githubusercontent.com/Hollowwill521/scripts/main/scripts/surge/360cam_ads.js,requires-body=true,max-size=131072

[MITM]
hostname = %APPEND% jia.360.cn, q5.jia.360.cn
